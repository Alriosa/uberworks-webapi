# =====================================================================================
# .gitignore for .NET / Visual Studio solutions
# =====================================================================================

# Visual Studio's internal cache folder (indexes, .suo, window layout).
# It's local to each machine, regenerates itself, and VS locks it while open
# (that's why "git add" was failing with Permission Denied).
.vs/

# Build outputs (regenerated with "dotnet build" / "dotnet restore").
bin/
obj/

# User/machine-specific config files (local paths, not meant to be shared).
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs and misc temp files from Visual Studio / MSBuild.
*.log
*.tmp
*.cache

# drawio backups/autosave (the real .drawio is versioned; .bkp/.dtmp are editor scratch).
*.bkp
*.dtmp

# Local secrets (in case a .env ever gets used instead of user-secrets).
.env
.env.local

# Uploaded professional profile photos (local-disk storage for now — see
# ProfessionalsController.UploadPhoto's FILE SUMMARY for the plan to move this to external
# storage later). Keep the folder itself tracked via .gitkeep, not the actual uploaded files.
uberworks-webapi/wwwroot/uploads/professional-photos/*
!uberworks-webapi/wwwroot/uploads/professional-photos/.gitkeep

# Uploaded report/dispute images (same local-disk-for-now plan — see
# ReportsController.Create's FILE SUMMARY).
uberworks-webapi/wwwroot/uploads/report-images/*
!uberworks-webapi/wwwroot/uploads/report-images/.gitkeep
