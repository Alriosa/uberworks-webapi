<div id="cancelReportModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-md rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300 p-6 sm:p-8" id="cancelReportModalBox">
        <button type="button" onclick="closeModal('cancelReportModal')" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-xl font-black text-slate-900 mb-1">Borrar Reporte</h3>
        <p class="text-sm text-slate-500 mb-6">Explica por qué se elimina este reporte.</p>
        <form asp-action="CancelReportAdmin" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="cancelReportId" />
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Motivo</label>
                <textarea name="reason" rows="3" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent resize-none"></textarea>
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" onclick="closeModal('cancelReportModal')" class="px-5 py-2.5 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancelar</button>
                <button type="submit" class="btn-alive relative overflow-hidden bg-red-600 hover:bg-red-700 text-white text-sm font-bold px-6 py-2.5 rounded-xl transition-colors">Borrar Reporte</button>
            </div>
        </form>
    </div>
</div>

<div id="toast" class="fixed bottom-6 right-6 z-50 glass-card px-5 py-4 rounded-2xl border border-brand-500/50 text-slate-900 shadow-2xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300">
    <div class="w-8 h-8 rounded-xl bg-brand-500 text-white flex items-center justify-center font-bold">
        <i class="fa-solid fa-check"></i>
    </div>
    <div>
        <p id="toastMessage" class="text-xs font-bold text-slate-900"></p>
        <p class="text-[10px] text-slate-500">Notificación de ServiGo</p>
    </div>
</div>

<script src="~/js/landing-common.js" asp-append-version="true"></script>
<script>
    function openEditUserModal(btn) {
        document.getElementById('editUserId').value = btn.dataset.id;
        document.getElementById('editUserUsername').value = btn.dataset.username || '';
        document.getElementById('editUserFirstName').value = btn.dataset.firstname || '';
        document.getElementById('editUserLastName').value = btn.dataset.lastname || '';
        document.getElementById('editUserEmail').value = btn.dataset.email || '';
        document.getElementById('editUserPhone').value = btn.dataset.phone || '';
        document.getElementById('editUserRole').value = btn.dataset.role || '';
        document.getElementById('editUserStatus').value = btn.dataset.status || '';
        openModal('editUserModal');
    }

    function openEditJobModal(btn) {
        document.getElementById('editJobId').value = btn.dataset.id;
        document.getElementById('editJobDescription').value = btn.dataset.description || '';
        document.getElementById('editJobPrice').value = btn.dataset.price || '';
        document.getElementById('editJobStatus').value = btn.dataset.status;
        document.getElementById('editJobZone').value = btn.dataset.zone || '';
        openModal('editJobModal');
    }

    function openJobDetailModal(tr) {
        const d = tr.dataset;
        document.getElementById('jdId').textContent = '#' + d.id;
        document.getElementById('jdStatus').textContent = d.status;
        document.getElementById('jdWorkType').textContent = d.worktype || '—';
        document.getElementById('jdClient').textContent = (d.clientfullname || '—') + ' (@@' + d.clientusername + ')';
        document.getElementById('jdDescription').textContent = d.description || 'Sin descripción.';
        document.getElementById('jdPrice').textContent = d.price ? ('₡' + d.price) : 'No propuesto todavía';
        document.getElementById('jdZone').textContent = d.zone || '—';
        document.getElementById('jdAddress').textContent = d.address || '—';
        document.getElementById('jdCoords').textContent = d.lat + ', ' + d.lng;
        document.getElementById('jdRequestDate').textContent = d.requestdate;

        const imageWrap = document.getElementById('jdImageWrap');
        if (d.imageurl) {
            document.getElementById('jdImage').src = d.imageurl;
            imageWrap.classList.remove('hidden');
        } else {
            imageWrap.classList.add('hidden');
        }

        const completionWrap = document.getElementById('jdCompletionWrap');
        if (d.clientconfirmed || d.professionalconfirmed || d.completionphotourl) {
            completionWrap.classList.remove('hidden');
            document.getElementById('jdClientConfirmed').textContent = d.clientconfirmed || 'Todavía no';
            document.getElementById('jdProfessionalConfirmed').textContent = d.professionalconfirmed || 'Todavía no';
            const photoWrap = document.getElementById('jdCompletionPhotoWrap');
            if (d.completionphotourl) {
                document.getElementById('jdCompletionPhoto').src = d.completionphotourl;
                photoWrap.classList.remove('hidden');
            } else {
                photoWrap.classList.add('hidden');
            }
        } else {
            completionWrap.classList.add('hidden');
        }

        openModal('jobDetailModal');
    }

    function openEditReportModal(btn) {
        document.getElementById('editReportId').value = btn.dataset.id;
        document.getElementById('editReportTitle').value = btn.dataset.title || '';
        document.getElementById('editReportDescription').value = btn.dataset.description || '';
        document.getElementById('editReportServiceId').value = btn.dataset.serviceid || '';
        document.getElementById('editReportClientId').value = btn.dataset.clientid || '';
        document.getElementById('editReportProfessionalId').value = btn.dataset.professionalid || '';
        document.getElementById('editReportIncidentDate').value = btn.dataset.incidentdate || '';
        openModal('editReportModal');
    }

    function openCancelReportModal(btn) {
        document.getElementById('cancelReportId').value = btn.dataset.id;
        openModal('cancelReportModal');
    }

    @if (TempData["AdminActionSuccess"] is string adminActionSuccess)
    {
        <text>document.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(Json.Serialize(adminActionSuccess))));</text>
    }
    @if (TempData["AdminActionError"] is string adminActionError)
    {
        <text>document.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(Json.Serialize(adminActionError))));</text>
    }
    @if (TempData["ReopenModal"] is string reopenModal)
    {
        <text>document.addEventListener('DOMContentLoaded', () => openModal(@Html.Raw(Json.Serialize(reopenModal))));</text>
    }
</script>
