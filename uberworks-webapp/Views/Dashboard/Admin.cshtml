@* ===== Reports modal — REAL CRUD (Create/Read/Update/Cancel) ===== *@
<div id="reportsModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-6xl max-h-[85vh] rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300 flex flex-col" id="reportsModalBox">
        <div class="flex items-start justify-between p-6 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-flag"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900">Incidencias y Reportes</h3>
                    <p class="text-xs text-slate-500">@Model.Reports.Count.ToString("N0") reportes en total</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="openModal('createReportModal')" class="btn-alive relative overflow-hidden bg-red-600 hover:bg-red-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition-colors">
                    <i class="fa-solid fa-plus mr-1"></i> Nuevo Reporte
                </button>
                <button onclick="closeModal('reportsModal')" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="overflow-auto p-6 pt-4">
            @if (Model.Reports.Count == 0)
            {
                <p class="text-sm text-slate-400 py-4 text-center">Todavía no hay reportes.</p>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-[10px] uppercase tracking-wide text-slate-400 border-b border-slate-100">
                            <th class="py-2 pr-4">ID</th>
                            <th class="py-2 pr-4">Título</th>
                            <th class="py-2 pr-4">Estado</th>
                            <th class="py-2 pr-4">Cliente</th>
                            <th class="py-2 pr-4">Profesional</th>
                            <th class="py-2 pr-4">Trabajo</th>
                            <th class="py-2 pr-4">Fecha</th>
                            <th class="py-2 pr-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.Reports)
                        {
                            <tr class="border-b border-slate-50 hover:bg-slate-50/70 cursor-pointer"
                                onclick="location.href='@Url.Action("SupportReportDetail", "Dashboard", new { id = report.Id })'">
                                <td class="py-2.5 pr-4 font-bold text-slate-900">#@report.Id</td>
                                <td class="py-2.5 pr-4 text-slate-700">@report.Title</td>
                                <td class="py-2.5 pr-4">
                                    @{
                                        var reportStatusClass = report.Status switch
                                        {
                                            ReportStatus.Resolved => "bg-emerald-50 text-emerald-600",
                                            ReportStatus.Pending => "bg-amber-50 text-amber-600",
                                            ReportStatus.Cancelled => "bg-slate-100 text-slate-500",
                                            _ => "bg-red-50 text-red-600"
                                        };
                                    }
                                    <span class="@reportStatusClass text-[11px] font-bold px-2 py-0.5 rounded-full">@report.Status</span>
                                </td>
                                <td class="py-2.5 pr-4 text-slate-500">@(report.ClientUsername ?? "—")</td>
                                <td class="py-2.5 pr-4 text-slate-500">@(report.ProfessionalUsername ?? "—")</td>
                                <td class="py-2.5 pr-4 text-slate-500">@(report.ServiceId is { } sid ? $"#{sid}" : "—")</td>
                                <td class="py-2.5 pr-4 text-slate-500">@report.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="py-2.5 pr-4" onclick="event.stopPropagation()">
                                    <div class="flex items-center gap-2">
                                        @if (report.Status != ReportStatus.Cancelled)
                                        {
                                            <button type="button"
                                                    class="text-blue-600 hover:text-blue-700 text-xs font-bold"
                                                    data-id="@report.Id" data-title="@report.Title" data-description="@report.Description"
                                                    data-serviceid="@report.ServiceId" data-clientid="@report.ClientUserId" data-professionalid="@report.ProfessionalUserId"
                                                    data-incidentdate="@(report.IncidentDate?.ToString("yyyy-MM-dd"))"
                                                    onclick="openEditReportModal(this)">
                                                <i class="fa-solid fa-pen"></i> Editar
                                            </button>
                                            <button type="button" class="text-red-600 hover:text-red-700 text-xs font-bold" data-id="@report.Id" onclick="openCancelReportModal(this)">
                                                <i class="fa-solid fa-ban"></i> Borrar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

