@* =====================================================================================
   FILE SUMMARY
   What it does: Shared dashboard for BOTH Role=Admin AND Role=MasterAdmin (see
                 DashboardController.LandingPage — MasterAdmin used to get its own decorative
                 MasterAdmin.cshtml with fake "Trabajos"/"Reportes" panels; that file was
                 retired in favor of full CRUD parity, which the user explicitly required:
                 "el master admin tiene que ser capaz de hacer todo lo que los demás pueden
                 hacer"). Model.IsMasterAdmin (true only for that role) swaps the header
                 title/icon and adds the one card MasterAdmin alone gets: "Finanzas" (its own
                 page, Views/Dashboard/Finances.cshtml). Every one of the 3 big CRUD panels is
                 REAL end-to-end for both roles: "Ver Todos los Usuarios" (GET /api/users, full
                 edit via PUT /api/users/{id}/admin-update, soft-delete via
                 DELETE /api/users/{id}), "Ver Todos los Trabajos" (GET /api/services admin
                 listing, edit/cancel via PUT+DELETE /api/services/{id} — Create is
                 deliberately NOT here, see DashboardController.UpdateServiceAdmin's comment
                 for why), and "Ver Todos los Reportes" (full CRUD against the Report system —
                 GET/POST/PUT /api/reports, cancel via POST /api/reports/{id}/cancel). The 4th
                 big card, "Crear Usuarios", links to the existing Admin/CreateUser page rather
                 than duplicating a role-creation form here — RoleHierarchy.cs already lists
                 Manager/Company/Support/Professional/Client as creatable by Admin (and
                 MasterAdmin can create Admin too — CreateUser.cshtml's role dropdown adapts).
                 Every edit modal is a SINGLE shared modal per panel (editUserModal/
                 editJobModal/editReportModal), populated via JS reading data-* attributes off
                 the row's "Editar" button (openEditUserModal(this) etc.) instead of one modal
                 per row — keeps the DOM small no matter how many rows exist. The Editar button
                 is hidden (replaced by a "Protegido" label) for the MasterAdmin row itself,
                 since PUT /api/users/{id}/admin-update rejects editing that account. TempData
                 ["ReopenModal"] tells the page which modal to re-open after a redirect if an
                 action failed (see DashboardController's UpdateXAdmin/DeleteXAdmin/
                 CreateReport/CancelReportAdmin actions).
                 Every job row and report row is clickable (cursor-pointer + hover, per explicit
                 request — "le hace falta un efecto de hover para saber en dónde estoy de pie"):
                 clicking a job row opens jobDetailModal (view-only, populated via JS from the
                 SAME data-* attributes the row already carries — no extra API call, every field
                 already comes down with GetAllForAdminAsync); clicking a report row navigates to
                 DashboardController.SupportReportDetail (the exact same real detail page Support
                 uses, already Authorize'd for MasterAdmin/Admin/Support). Both stop click
                 propagation on their "Acciones" cell so Editar/Cancelar/Borrar still work without
                 also triggering the row-level handler.
                 "Log out" (not "Atrás") is this page's navigation-continuity requirement —
                 this dashboard has no natural parent page.
   Entities connected: None — this project has no database entities
   Tables related: None — Model.Users/Services/Reports reach TBL_USERS/TBL_SERVICES/
                   TBL_REPORTS only indirectly, through the API
   ===================================================================================== *@
@model uberworks_webapp.Models.ViewModels.AdminDashboardViewModel
@using uberworks_webapp.Models.ApiContracts
@{
    ViewData["Title"] = Model.IsMasterAdmin ? "Panel de MasterAdmin" : "Panel de Admin";
    Layout = "_LandingLayout";

    var openOrPendingReports = Model.Reports.Count(r => r.Status is ReportStatus.Open or ReportStatus.Pending);
}

<partial name="_LandingHeader" />

<main class="relative min-h-screen bg-slate-50 pt-28 pb-8 px-4 sm:px-6 lg:px-8 z-10">
    <div class="max-w-7xl mx-auto space-y-6">

        <div class="glass-card rounded-3xl border border-slate-200 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-slate-900 text-white flex items-center justify-center text-xl">
                    <i class="fa-solid @(Model.IsMasterAdmin ? "fa-crown" : "fa-user-tie")"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-slate-900">@(Model.IsMasterAdmin ? "Panel de MasterAdmin" : "Panel de Admin")</h1>
                    <p class="text-sm text-slate-500 mt-0.5">Hola, @Model.DisplayName — gestión de usuarios, trabajos y reportes</p>
                </div>
            </div>
            <div class="flex flex-col gap-2 self-start sm:self-auto">
                <button onclick="location.reload()" class="btn-alive relative overflow-hidden inline-flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 font-bold text-sm px-4 py-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span>Actualizar</span>
                </button>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-alive relative overflow-hidden w-full inline-flex items-center justify-center gap-2 bg-slate-900 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:bg-slate-800 transition-colors">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Log out</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="glass-card rounded-2xl border border-slate-200 p-4 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Usuarios Totales</p>
                    <p class="text-lg font-black text-slate-900">@Model.Users.Count.ToString("N0")</p>
                </div>
            </div>
            <div class="glass-card rounded-2xl border border-slate-200 p-4 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Trabajos Registrados</p>
                    <p class="text-lg font-black text-slate-900">@Model.Services.Count.ToString("N0")</p>
                </div>
            </div>
            <div class="glass-card rounded-2xl border border-slate-200 p-4 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Reportes Abiertos</p>
                    <p class="text-lg font-black text-slate-900">@openOrPendingReports.ToString("N0")</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

            <button onclick="openModal('usersModal')" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-blue-50"></div>
                <div class="relative flex items-start justify-between mb-6">
                    <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-2.5 py-1 rounded-full">@Model.Users.Count.ToString("N0") REGISTRADOS</span>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Ver Todos los Usuarios</h3>
                <p class="relative text-sm text-slate-500 mb-4 max-w-md">Editar datos, revisar rol/estado, y eliminar cuentas.</p>
                <span class="relative text-blue-600 font-bold text-sm inline-flex items-center gap-1.5">Gestionar Usuarios <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </button>

            <button onclick="openModal('jobsModal')" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-amber-50"></div>
                <div class="relative flex items-start justify-between mb-6">
                    <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-2.5 py-1 rounded-full">@Model.Services.Count.ToString("N0") EN TOTAL</span>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Ver Todos los Trabajos</h3>
                <p class="relative text-sm text-slate-500 mb-4 max-w-md">Editar precio/estado/zona, o cancelar un trabajo publicado.</p>
                <span class="relative text-amber-600 font-bold text-sm inline-flex items-center gap-1.5">Ver Lista de Trabajos <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </button>

            <button onclick="openModal('reportsModal')" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-red-50"></div>
                <div class="relative flex items-start justify-between mb-6">
                    <div class="w-12 h-12 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-flag"></i>
                    </div>
                    <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-2.5 py-1 rounded-full">@openOrPendingReports.ToString("N0") ABIERTOS</span>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Ver Todos los Reportes</h3>
                <p class="relative text-sm text-slate-500 mb-4 max-w-md">Crear, editar o cancelar reportes de disputas/incidentes.</p>
                <span class="relative text-red-600 font-bold text-sm inline-flex items-center gap-1.5">Revisar Incidencias <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </button>

            <a asp-controller="Admin" asp-action="CreateUser" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 block">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-emerald-50"></div>
                <div class="relative flex items-start justify-between mb-6">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-2.5 py-1 rounded-full">MANAGER · COMPANY · SUPPORT</span>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Crear Usuarios</h3>
                <p class="relative text-sm text-slate-500 mb-4 max-w-md">Registrar cuentas de Manager, Company, Support, Professional o Client.</p>
                <span class="relative text-emerald-600 font-bold text-sm inline-flex items-center gap-1.5">Registrar un Usuario <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </a>

            @if (Model.IsMasterAdmin)
            {
                <a asp-controller="Dashboard" asp-action="Finances" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 block">
                    <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-violet-50"></div>
                    <div class="relative flex items-start justify-between mb-6">
                        <div class="w-12 h-12 rounded-2xl bg-violet-100 text-violet-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                        <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-2.5 py-1 rounded-full">MASTERADMIN</span>
                    </div>
                    <h3 class="relative text-xl font-black text-slate-900 mb-1">Finanzas</h3>
                    <p class="relative text-sm text-slate-500 mb-4 max-w-md">Ingresos diarios/mensuales de la plataforma.</p>
                    <span class="relative text-violet-600 font-bold text-sm inline-flex items-center gap-1.5">Ver Finanzas <i class="fa-solid fa-arrow-right text-xs"></i></span>
                </a>
            }

        </div>
    </div>
</main>

<partial name="_LandingFooter" />

@* ===== Users modal — REAL CRUD ===== *@
<div id="usersModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-6xl max-h-[85vh] rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300 flex flex-col" id="usersModalBox">
        <div class="flex items-start justify-between p-6 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900">Directorio General de Usuarios</h3>
                    <p class="text-xs text-slate-500">@Model.Users.Count.ToString("N0") usuarios registrados</p>
                </div>
            </div>
            <button onclick="closeModal('usersModal')" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="overflow-auto p-6 pt-4">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-[10px] uppercase tracking-wide text-slate-400 border-b border-slate-100">
                        <th class="py-2 pr-4">ID</th>
                        <th class="py-2 pr-4">Username</th>
                        <th class="py-2 pr-4">Nombre</th>
                        <th class="py-2 pr-4">Email</th>
                        <th class="py-2 pr-4">Teléfono</th>
                        <th class="py-2 pr-4">Rol</th>
                        <th class="py-2 pr-4">Estado</th>
                        <th class="py-2 pr-4">Registrado</th>
                        <th class="py-2 pr-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr class="border-b border-slate-50 hover:bg-slate-50/70">
                            <td class="py-2.5 pr-4 text-slate-500">#@user.Id</td>
                            <td class="py-2.5 pr-4 font-bold text-slate-900">@user.Username</td>
                            <td class="py-2.5 pr-4 text-slate-700">@user.FirstName @user.LastName</td>
                            <td class="py-2.5 pr-4 text-slate-500">@user.Email</td>
                            <td class="py-2.5 pr-4 text-slate-500">@(user.Phone ?? "—")</td>
                            <td class="py-2.5 pr-4"><span class="bg-slate-100 text-slate-600 text-[11px] font-bold px-2 py-0.5 rounded-full">@user.Role</span></td>
                            <td class="py-2.5 pr-4">
                                @{
                                    var statusClass = user.Status == UserStatus.Active ? "bg-emerald-50 text-emerald-600" : "bg-red-50 text-red-600";
                                }
                                <span class="@statusClass text-[11px] font-bold px-2 py-0.5 rounded-full">@user.Status</span>
                            </td>
                            <td class="py-2.5 pr-4 text-slate-500">@user.RegistrationDate.ToString("dd/MM/yyyy")</td>
                            <td class="py-2.5 pr-4">
                                <div class="flex items-center gap-2">
                                    @if (user.Role == UserRole.MasterAdmin)
                                    {
                                        <span class="text-slate-300 text-xs font-bold" title="La cuenta MasterAdmin no se puede editar desde aquí">
                                            <i class="fa-solid fa-lock"></i> Protegido
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="text-blue-600 hover:text-blue-700 text-xs font-bold"
                                                data-id="@user.Id" data-username="@user.Username" data-firstname="@user.FirstName" data-lastname="@user.LastName"
                                                data-email="@user.Email" data-phone="@user.Phone" data-role="@((int)user.Role)" data-status="@((int)user.Status)"
                                                onclick="openEditUserModal(this)">
                                            <i class="fa-solid fa-pen"></i> Editar
                                        </button>
                                    }
                                    @if (user.Role != UserRole.MasterAdmin && user.Status != UserStatus.Deleted)
                                    {
                                        <form asp-action="DeleteUserAdmin" method="post" onsubmit="return confirm('¿Eliminar a @user.Username? Esta cuenta ya no podrá iniciar sesión.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="text-red-600 hover:text-red-700 text-xs font-bold">
                                                <i class="fa-solid fa-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ===== Jobs ("Trabajos") modal — REAL CRUD (Read/Update/Delete) ===== *@
<div id="jobsModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-6xl max-h-[85vh] rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300 flex flex-col" id="jobsModalBox">
        <div class="flex items-start justify-between p-6 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900">Listado Central de Trabajos</h3>
                    <p class="text-xs text-slate-500">@Model.Services.Count.ToString("N0") trabajos registrados, todos los estados</p>
                </div>
            </div>
            <button onclick="closeModal('jobsModal')" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="overflow-auto p-6 pt-4">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-[10px] uppercase tracking-wide text-slate-400 border-b border-slate-100">
                        <th class="py-2 pr-4">ID</th>
                        <th class="py-2 pr-4">Categoría</th>
                        <th class="py-2 pr-4">Cliente</th>
                        <th class="py-2 pr-4">Estado</th>
                        <th class="py-2 pr-4">Precio</th>
                        <th class="py-2 pr-4">Zona</th>
                        <th class="py-2 pr-4">Fecha</th>
                        <th class="py-2 pr-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Services)
                    {
                        <tr class="border-b border-slate-50 hover:bg-slate-50/70 cursor-pointer"
                            data-id="@job.Id" data-worktype="@job.WorkTypeName"
                            data-clientusername="@job.ClientUsername" data-clientfullname="@job.ClientFullName"
                            data-description="@job.Description" data-imageurl="@job.ImageUrl"
                            data-price="@(job.ProposedPrice?.ToString("0.##"))" data-status="@job.Status"
                            data-requestdate="@job.RequestDate.ToString("dd/MM/yyyy HH:mm")"
                            data-address="@job.ExactAddress" data-zone="@job.Zone"
                            data-lat="@job.Latitude" data-lng="@job.Longitude"
                            data-completionphotourl="@job.CompletionPhotoUrl"
                            data-clientconfirmed="@(job.ClientConfirmedCompletionAt?.ToString("dd/MM/yyyy HH:mm"))"
                            data-professionalconfirmed="@(job.ProfessionalConfirmedCompletionAt?.ToString("dd/MM/yyyy HH:mm"))"
                            onclick="openJobDetailModal(this)">
                            <td class="py-2.5 pr-4 font-bold text-slate-900">#@job.Id</td>
                            <td class="py-2.5 pr-4 text-slate-700">@job.WorkTypeName</td>
                            <td class="py-2.5 pr-4 text-slate-500">@job.ClientUsername</td>
                            <td class="py-2.5 pr-4">
                                @{
                                    var jobStatusClass = job.Status switch
                                    {
                                        ServiceStatus.Completed => "bg-emerald-50 text-emerald-600",
                                        ServiceStatus.Accepted => "bg-amber-50 text-amber-600",
                                        ServiceStatus.Cancelled => "bg-slate-100 text-slate-500",
                                        _ => "bg-blue-50 text-blue-600"
                                    };
                                }
                                <span class="@jobStatusClass text-[11px] font-bold px-2 py-0.5 rounded-full">@job.Status</span>
                            </td>
                            <td class="py-2.5 pr-4 text-slate-900 font-bold">@(job.ProposedPrice is { } price ? price.ToString("C") : "—")</td>
                            <td class="py-2.5 pr-4 text-slate-500">@job.Zone</td>
                            <td class="py-2.5 pr-4 text-slate-500">@job.RequestDate.ToString("dd/MM/yyyy")</td>
                            <td class="py-2.5 pr-4" onclick="event.stopPropagation()">
                                <div class="flex items-center gap-2">
                                    <button type="button"
                                            class="text-blue-600 hover:text-blue-700 text-xs font-bold"
                                            data-id="@job.Id" data-description="@job.Description" data-price="@job.ProposedPrice" data-status="@((int)job.Status)" data-zone="@job.Zone"
                                            onclick="openEditJobModal(this)">
                                        <i class="fa-solid fa-pen"></i> Editar
                                    </button>
                                    @if (job.Status != ServiceStatus.Cancelled)
                                    {
                                        <form asp-action="DeleteServiceAdmin" method="post" onsubmit="return confirm('¿Cancelar el trabajo #@job.Id?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@job.Id" />
                                            <button type="submit" class="text-red-600 hover:text-red-700 text-xs font-bold">
                                                <i class="fa-solid fa-ban"></i> Cancelar
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ===== Job detail modal (view-only, populated via JS from the row's data-* attributes —
   every field already comes down with the listing, so no extra API call is needed) ===== *@
<div id="jobDetailModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-lg max-h-[85vh] overflow-auto rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300 p-6 sm:p-8" id="jobDetailModalBox">
        <button type="button" onclick="closeModal('jobDetailModal')" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-xl font-black text-slate-900 mb-1">Detalle del Trabajo <span id="jdId" class="text-slate-400"></span></h3>
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-5" id="jdStatus"></p>
        <div class="space-y-3 text-sm">
            <div><span class="font-bold text-slate-700">Categoría:</span> <span id="jdWorkType" class="text-slate-600"></span></div>
            <div><span class="font-bold text-slate-700">Cliente:</span> <span id="jdClient" class="text-slate-600"></span></div>
            <div><span class="font-bold text-slate-700">Descripción:</span> <span id="jdDescription" class="text-slate-600"></span></div>
