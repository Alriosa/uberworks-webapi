@* =====================================================================================
   FILE SUMMARY
   What it does: A Professional's own view of Event invitations sent by companies they're
                 linked to — "Genera una vista de todo esa parte", per explicit request.
                 A dedicated page (not a modal), reached via its own link on the Professional
                 dashboard, since it doesn't belong inside another panel. Every invitation
                 shows the full picture (qué se necesita, qué no, fecha, lugar, empresa) and,
                 while still Pending, two REAL buttons — Aceptar/Rechazar — that post to
                 DashboardController.RespondToInvitation → POST
                 /api/events/invitations/{id}/respond. Already-answered invitations show their
                 outcome instead of the buttons (an invitation can only be answered once — see
                 IEventService.RespondToInvitationAsync on the API side).
   Entities connected: None — this project has no database entities
   Tables related: None — Model reaches TBL_EVENT_INVITATIONS/TBL_EVENTS only indirectly, through the API
   ===================================================================================== *@
@model List<uberworks_webapp.Models.ApiContracts.EventInvitationResponse>
@using uberworks_webapp.Models.ApiContracts
@{
    ViewData["Title"] = "Invitaciones a Eventos";
    Layout = "_LandingLayout";
}

<partial name="_LandingHeader" />

<main class="relative min-h-screen bg-slate-50 pt-28 pb-8 px-4 sm:px-6 lg:px-8 z-10">
    <div class="max-w-3xl mx-auto space-y-6">

        <div class="glass-card rounded-3xl border border-slate-200 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-xl">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-slate-900">Invitaciones a Eventos</h1>
                    <p class="text-sm text-slate-500 mt-0.5">@Model.Count.ToString("N0") invitaciones recibidas</p>
                </div>
            </div>
            <a asp-controller="Dashboard" asp-action="LandingPage" class="btn-alive relative overflow-hidden inline-flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 font-bold text-sm px-4 py-2.5 rounded-xl hover:bg-slate-50 transition-colors self-start sm:self-auto">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Atrás — Volver al Panel</span>
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="glass-card rounded-3xl border border-slate-200 p-10 text-center">
                <p class="text-sm text-slate-400">Todavía no tienes invitaciones a eventos.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var invitation in Model)
                {
                    <div class="glass-card rounded-3xl border border-slate-200 p-6">
                        <div class="flex items-start justify-between gap-4 mb-3">
                            <div>
                                <h2 class="text-lg font-black text-slate-900">@invitation.EventTitle</h2>
                                <p class="text-xs text-slate-500 mt-0.5">Empresa: @invitation.CompanyName</p>
                            </div>
                            @{
                                var badgeClass = invitation.Status switch
                                {
                                    EventInvitationStatus.Accepted => "bg-emerald-50 text-emerald-600",
                                    EventInvitationStatus.Declined => "bg-red-50 text-red-600",
                                    _ => "bg-amber-50 text-amber-600"
                                };
                            }
                            <span class="@badgeClass text-[11px] font-bold px-3 py-1 rounded-full shrink-0">@invitation.Status</span>
                        </div>

                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm mb-4">
                            <div><dt class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Fecha</dt><dd class="text-slate-900">@invitation.EventDate.ToString("dd/MM/yyyy HH:mm")</dd></div>
                            <div><dt class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Lugar</dt><dd class="text-slate-900">@invitation.EventLocation</dd></div>
                            <div class="sm:col-span-2"><dt class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Qué va a ser necesario</dt><dd class="text-slate-900">@invitation.EventDescription</dd></div>
                            @if (!string.IsNullOrEmpty(invitation.EventNotIncluded))
                            {
                                <div class="sm:col-span-2"><dt class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Qué NO se necesita</dt><dd class="text-slate-900">@invitation.EventNotIncluded</dd></div>
                            }
                        </dl>

                        @if (invitation.Status == EventInvitationStatus.Pending)
                        {
                            <div class="flex items-center gap-3">
                                <form asp-action="RespondToInvitation" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@invitation.Id" />
                                    <input type="hidden" name="accept" value="true" />
                                    <button type="submit" class="btn-alive relative overflow-hidden bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold px-5 py-2.5 rounded-xl transition-colors">
                                        <i class="fa-solid fa-check mr-1"></i> Aceptar
                                    </button>
                                </form>
                                <form asp-action="RespondToInvitation" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@invitation.Id" />
                                    <input type="hidden" name="accept" value="false" />
                                    <button type="submit" class="btn-alive relative overflow-hidden bg-white border border-slate-200 text-slate-700 text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                                        <i class="fa-solid fa-xmark mr-1"></i> Rechazar
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-slate-400">Respondiste el @invitation.RespondedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</main>

<partial name="_LandingFooter" />

<div id="toast" class="fixed bottom-6 right-6 z-50 glass-card px-5 py-4 rounded-2xl border border-brand-500/50 text-slate-900 shadow-2xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300">
    <div class="w-8 h-8 rounded-xl bg-brand-500 text-white flex items-center justify-center font-bold">
        <i class="fa-solid fa-check"></i>
    </div>
    <div>
        <p id="toastMessage" class="text-xs font-bold text-slate-900"></p>
        <p class="text-[10px] text-slate-500">Notificación de ServiGo</p>
    </div>
</div>

<script src="~/js/landing-common.js" asp-append-version="true"></script>
<script>
    @if (TempData["EditProfileSuccess"] is string successMessage)
    {
        <text>document.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(Json.Serialize(successMessage))));</text>
    }
    @if (TempData["EditProfileError"] is string errorMessage)
    {
        <text>document.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(Json.Serialize(errorMessage))));</text>
    }
</script>
