@* =====================================================================================
   FILE SUMMARY
   What it does: Client's dashboard — landing page after login for Role=Client (see
                 DashboardController.LandingPage). Same Spanish-language exception and
                 _LandingLayout.cshtml Tailwind reuse as the other dashboards, plus
                 wwwroot/js/landing-common.js for the shared openModal()/closeModal()/
                 showToast(). 4 big buttons: "Ocupo un trabajo" is REAL navigation to
                 Home/AllServices (there's no WebApp form wired to POST /api/services yet,
                 even though that endpoint exists — browsing categories is the closest real
                 destination today); "Histórico de Trabajos" opens a modal with REAL data
                 (Model.MyServices, from GET /api/services/mine) — each row is clickable
                 (hover + click, per explicit request) and opens myServiceDetailModal with
                 every field the row already carries (description, image, exact address,
                 completion photo/dates) PLUS "quién lo hizo", fetched on demand from
                 DashboardController.ClientServiceProfessional since the accepted professional
                 isn't part of ServiceResponse itself; "Editar mi Perfil" opens a
                 modal with REAL data (Model.CurrentUser/Model.EditProfile) that posts to
                 DashboardController.UpdateProfile → PUT /api/users/{id} (only
                 FirstName/LastName/Phone are editable, same restriction the API enforces);
                 "Contactar con Soporte" is ALSO real now — links to
                 Dashboard/ContactSupport.cshtml, a dedicated page (not a modal) that files a
                 real Report via POST /api/reports/contact-support, per explicit request. The
                 thin "Recargar Saldo" button stays DECORATIVE (no wallet/balance system
                 exists in the app yet) — it just shows a toast for now. The small "Saldo" box
                 in the header card (next to Log out) is the same kind of placeholder — a
                 hardcoded ₡0.00, not real data.
   Entities connected: None — this project has no database entities
   Tables related: None — Model.MyServices/Model.CurrentUser reach TBL_SERVICES/TBL_USERS
                   only indirectly, through the API
   ===================================================================================== *@
@model uberworks_webapp.Models.ViewModels.ClientDashboardViewModel
@{
    ViewData["Title"] = "Panel de Cliente";
    Layout = "_LandingLayout";
}

<partial name="_LandingHeader" />

<main class="relative min-h-screen bg-slate-50 pt-28 pb-8 px-4 sm:px-6 lg:px-8 z-10">
    <div class="max-w-5xl mx-auto space-y-6">

        <div class="glass-card rounded-3xl border border-slate-200 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-brand-500 text-white flex items-center justify-center text-xl">
                    <i class="fa-solid fa-house-user"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-slate-900">Panel de Cliente</h1>
                    <p class="text-sm text-slate-500 mt-0.5">Hola, @Model.DisplayName — ¿qué necesitas hoy?</p>
                </div>
            </div>
            <div class="flex items-center gap-3 self-start sm:self-auto">
                @* Placeholder balance box — no real Payment/wallet system exists in the app
                   yet, per explicit request ("coloca un número ahorita x, dado de que no
                   vamos a trabajar con la parte todavía de saldo"). Hardcoded ₡0, not real data. *@
                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-right">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Saldo</p>
                    <p class="text-sm font-black text-slate-900">₡0.00</p>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-alive relative overflow-hidden inline-flex items-center justify-center gap-2 bg-slate-900 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:bg-slate-800 transition-colors">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Log out</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <a asp-controller="Home" asp-action="AllServices" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 block">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-emerald-50"></div>
                <div class="relative w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl mb-6">
                    <i class="fa-solid fa-hammer"></i>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Ocupo un Trabajo</h3>
                <p class="relative text-sm text-slate-500 mb-4">Explora las categorías de servicios y pide ayuda al instante.</p>
                <span class="relative text-emerald-600 font-bold text-sm inline-flex items-center gap-1.5">Buscar servicio <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </a>

            <button onclick="openModal('historyModal')" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-blue-50"></div>
                <div class="relative w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl mb-6">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Histórico de Trabajos</h3>
                <p class="relative text-sm text-slate-500 mb-4">Revisa todos los servicios que has pedido — @Model.MyServices.Count.ToString("N0") en total.</p>
                <span class="relative text-blue-600 font-bold text-sm inline-flex items-center gap-1.5">Ver historial <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </button>

            <button onclick="openModal('editProfileModal')" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-purple-50"></div>
                <div class="relative w-12 h-12 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl mb-6">
                    <i class="fa-solid fa-user-pen"></i>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Editar Mi Perfil</h3>
                <p class="relative text-sm text-slate-500 mb-4">Actualiza tu nombre y teléfono de contacto.</p>
                <span class="relative text-purple-600 font-bold text-sm inline-flex items-center gap-1.5">Editar datos <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </button>

            <a asp-controller="Dashboard" asp-action="ContactSupport" class="glass-card text-left rounded-3xl border border-slate-200 p-6 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 block">
                <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full bg-amber-50"></div>
                <div class="relative w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl mb-6">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <h3 class="relative text-xl font-black text-slate-900 mb-1">Contactar con Soporte</h3>
                <p class="relative text-sm text-slate-500 mb-4">¿Tienes un problema con un servicio? Escríbenos.</p>
                <span class="relative text-amber-600 font-bold text-sm inline-flex items-center gap-1.5">Contactar <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </a>

        </div>

        <button onclick="showToast('Recarga de saldo estará disponible próximamente.')" class="btn-alive relative overflow-hidden w-full glass-card rounded-2xl border border-slate-200 py-4 flex items-center justify-center gap-2 text-slate-700 font-bold text-sm hover:-translate-y-0.5 hover:shadow-lg transition-all duration-300">
            <i class="fa-solid fa-wallet"></i>
            <span>Recargar Saldo</span>
        </button>

    </div>
</main>

<partial name="_LandingFooter" />

@* ===== Histórico de Trabajos modal — REAL data (Model.MyServices) ===== *@
<div id="historyModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-3xl max-h-[85vh] rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300 flex flex-col" id="historyModalBox">
        <div class="flex items-start justify-between p-6 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900">Histórico de Trabajos</h3>
                    <p class="text-xs text-slate-500">@Model.MyServices.Count.ToString("N0") servicios pedidos en total</p>
                </div>
            </div>
            <button onclick="closeModal('historyModal')" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="overflow-auto p-6 pt-4">
            @if (Model.MyServices.Count == 0)
            {
                <p class="text-sm text-slate-400 py-6 text-center">Todavía no has pedido ningún servicio.</p>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-[10px] uppercase tracking-wide text-slate-400 border-b border-slate-100">
                            <th class="py-2 pr-4">Categoría</th>
                            <th class="py-2 pr-4">Zona</th>
                            <th class="py-2 pr-4">Precio</th>
                            <th class="py-2 pr-4">Estado</th>
                            <th class="py-2 pr-4">Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in Model.MyServices)
                        {
                            <tr class="border-b border-slate-50 hover:bg-slate-50/70 cursor-pointer"
                                data-id="@service.Id" data-worktype="@service.WorkTypeName"
                                data-description="@service.Description" data-imageurl="@service.ImageUrl"
                                data-price="@(service.ProposedPrice?.ToString("0.##"))" data-status="@service.Status"
                                data-requestdate="@service.RequestDate.ToString("dd/MM/yyyy HH:mm")"
                                data-address="@service.ExactAddress" data-zone="@service.Zone"
                                data-completionphotourl="@service.CompletionPhotoUrl"
                                data-clientconfirmed="@(service.ClientConfirmedCompletionAt?.ToString("dd/MM/yyyy HH:mm"))"
                                data-professionalconfirmed="@(service.ProfessionalConfirmedCompletionAt?.ToString("dd/MM/yyyy HH:mm"))"
                                onclick="openMyServiceDetailModal(this)">
                                <td class="py-2.5 pr-4 font-bold text-slate-900">@service.WorkTypeName</td>
                                <td class="py-2.5 pr-4 text-slate-500">@service.Zone</td>
                                <td class="py-2.5 pr-4 text-slate-900">@(service.ProposedPrice.HasValue ? $"${service.ProposedPrice.Value:0.00}" : "—")</td>
                                <td class="py-2.5 pr-4">
                                    <span class="bg-slate-100 text-slate-600 text-[11px] font-bold px-2 py-0.5 rounded-full">@service.Status</span>
                                </td>
                                <td class="py-2.5 pr-4 text-slate-500">@service.RequestDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@* ===== Editar Mi Perfil modal — REAL data, posts to DashboardController.UpdateProfile ===== *@
<div id="editProfileModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-lg rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300" id="editProfileModalBox">
        <button type="button" onclick="closeModal('editProfileModal')" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="p-6 sm:p-8">
            <h3 class="text-xl font-black text-slate-900 mb-1">Editar Mi Perfil</h3>
            <p class="text-sm text-slate-500 mb-6">Solo el nombre, apellido y teléfono se pueden editar aquí.</p>

            <form asp-controller="Dashboard" asp-action="UpdateProfile" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Username</label>
                    <input type="text" value="@Model.CurrentUser.Username" disabled
                           class="w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm text-slate-500" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Email</label>
                    <input type="text" value="@Model.CurrentUser.Email" disabled
                           class="w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm text-slate-500" />
                </div>

                <div>
                    <label asp-for="EditProfile.FirstName" class="block text-xs font-bold text-slate-700 mb-1">Nombre</label>
                    <input asp-for="EditProfile.FirstName"
                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>

                <div>
                    <label asp-for="EditProfile.LastName" class="block text-xs font-bold text-slate-700 mb-1">Apellido</label>
                    <input asp-for="EditProfile.LastName"
                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>

                <div>
                    <label asp-for="EditProfile.Phone" class="block text-xs font-bold text-slate-700 mb-1">Teléfono</label>
                    <input asp-for="EditProfile.Phone"
                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" onclick="closeModal('editProfileModal')" class="px-5 py-2.5 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-alive relative overflow-hidden bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold px-6 py-2.5 rounded-xl transition-colors">
                        Guardar Información
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ===== "Mi Trabajo" detail modal (view-only) — most fields come straight from the row's
   data-* attributes (already loaded with the history list, no extra call needed); "quién
   lo hizo" is fetched on demand from DashboardController.ClientServiceProfessional since it
   isn't part of ServiceResponse (a Service can have several competing proposals, only one
   Accepted) ===== *@
<div id="myServiceDetailModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-lg max-h-[85vh] overflow-auto rounded-3xl border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300 p-6 sm:p-8" id="myServiceDetailModalBox">
        <button type="button" onclick="closeModal('myServiceDetailModal')" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-xl font-black text-slate-900 mb-1">Detalle del Trabajo <span id="msdId" class="text-slate-400"></span></h3>
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-5" id="msdStatus"></p>
        <div class="space-y-3 text-sm">
            <div><span class="font-bold text-slate-700">Categoría:</span> <span id="msdWorkType" class="text-slate-600"></span></div>
            <div><span class="font-bold text-slate-700">Realizado por:</span> <span id="msdProfessional" class="text-slate-600">Consultando…</span></div>
            <div><span class="font-bold text-slate-700">Descripción:</span> <span id="msdDescription" class="text-slate-600"></span></div>
            <div><span class="font-bold text-slate-700">Precio Pagado:</span> <span id="msdPrice" class="text-slate-600"></span></div>
            <div><span class="font-bold text-slate-700">Zona:</span> <span id="msdZone" class="text-slate-600"></span></div>
            <div><span class="font-bold text-slate-700">Dirección:</span> <span id="msdAddress" class="text-slate-600"></span></div>
            <div><span class="font-bold text-slate-700">Fecha de Solicitud:</span> <span id="msdRequestDate" class="text-slate-600"></span></div>
            <div id="msdImageWrap" class="hidden">
                <span class="font-bold text-slate-700 block mb-1">Imagen Adjunta:</span>
                <img id="msdImage" class="rounded-xl max-h-64 border border-slate-200" />
            </div>
            <div id="msdCompletionWrap" class="hidden border-t border-slate-100 pt-3 mt-3 space-y-2">
                <p class="font-black text-slate-900">Finalización</p>
                <div id="msdCompletionPhotoWrap" class="hidden">
                    <span class="font-bold text-slate-700 block mb-1">Foto de Finalización:</span>
                    <img id="msdCompletionPhoto" class="rounded-xl max-h-64 border border-slate-200" />
                </div>
                <div><span class="font-bold text-slate-700">Confirmaste que se completó:</span> <span id="msdClientConfirmed" class="text-slate-600"></span></div>
                <div><span class="font-bold text-slate-700">El profesional confirmó:</span> <span id="msdProfessionalConfirmed" class="text-slate-600"></span></div>
            </div>
        </div>
        <div class="flex items-center justify-between pt-5">
            <a id="msdChatLink" href="#" class="btn-alive relative overflow-hidden inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold px-4 py-2.5 rounded-xl transition-colors">
                <i class="fa-solid fa-comment-dots"></i> Chatear con el Profesional
            </a>
            <button type="button" onclick="closeModal('myServiceDetailModal')" class="px-5 py-2.5 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cerrar</button>
        </div>
    </div>
</div>

<div id="toast" class="fixed bottom-6 right-6 z-50 glass-card px-5 py-4 rounded-2xl border border-brand-500/50 text-slate-900 shadow-2xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300">
    <div class="w-8 h-8 rounded-xl bg-brand-500 text-white flex items-center justify-center font-bold">
        <i class="fa-solid fa-check"></i>
    </div>
    <div>
        <p id="toastMessage" class="text-xs font-bold text-slate-900"></p>
        <p class="text-[10px] text-slate-500">Notificación de ServiGo</p>
    </div>
</div>

<script src="~/js/landing-common.js" asp-append-version="true"></script>
<script>
    function openMyServiceDetailModal(tr) {
        const d = tr.dataset;
        document.getElementById('msdId').textContent = '#' + d.id;
        document.getElementById('msdStatus').textContent = d.status;
        document.getElementById('msdWorkType').textContent = d.worktype || '—';
        document.getElementById('msdDescription').textContent = d.description || 'Sin descripción.';
        document.getElementById('msdPrice').textContent = d.price ? ('$' + d.price) : 'No propuesto todavía';
        document.getElementById('msdZone').textContent = d.zone || '—';
        document.getElementById('msdAddress').textContent = d.address || '—';
        document.getElementById('msdRequestDate').textContent = d.requestdate;

        // Chat only makes sense once a professional has actually been accepted — Service.Status
        // becomes Accepted/Completed exactly when that happens (see ServiceProfessionalService
        // .AcceptProposalAsync on the API side).
        const chatLink = document.getElementById('msdChatLink');
        if (d.status === 'Accepted' || d.status === 'Completed') {
            chatLink.href = '@Url.Action("Chat", "Dashboard")?serviceId=' + encodeURIComponent(d.id);
            chatLink.classList.remove('hidden');
        } else {
            chatLink.classList.add('hidden');
        }

        const imageWrap = document.getElementById('msdImageWrap');
        if (d.imageurl) {
            document.getElementById('msdImage').src = d.imageurl;
            imageWrap.classList.remove('hidden');
        } else {
            imageWrap.classList.add('hidden');
        }

        const completionWrap = document.getElementById('msdCompletionWrap');
        if (d.clientconfirmed || d.professionalconfirmed || d.completionphotourl) {
            completionWrap.classList.remove('hidden');
            document.getElementById('msdClientConfirmed').textContent = d.clientconfirmed || 'Todavía no';
            document.getElementById('msdProfessionalConfirmed').textContent = d.professionalconfirmed || 'Todavía no';
            const photoWrap = document.getElementById('msdCompletionPhotoWrap');
            if (d.completionphotourl) {
                document.getElementById('msdCompletionPhoto').src = d.completionphotourl;
                photoWrap.classList.remove('hidden');
            } else {
                photoWrap.classList.add('hidden');
            }
        } else {
            completionWrap.classList.add('hidden');
        }

        const professionalEl = document.getElementById('msdProfessional');
        professionalEl.textContent = 'Consultando…';
        fetch('@Url.Action("ClientServiceProfessional", "Dashboard")?serviceId=' + encodeURIComponent(d.id))
            .then(r => r.json())
            .then(data => {
                professionalEl.textContent = data.found
                    ? data.name + (data.rating ? ` (★ ${Number(data.rating).toFixed(1)})` : '')
                    : 'Todavía sin profesional asignado';
            })
            .catch(() => { professionalEl.textContent = 'No se pudo consultar.'; });

        openModal('myServiceDetailModal');
    }

    @if (TempData["EditProfileSuccess"] is string editProfileSuccess)
    {
        <text>document.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(Json.Serialize(editProfileSuccess))));</text>
    }
    @if (TempData["EditProfileError"] is string editProfileError)
    {
        <text>document.addEventListener('DOMContentLoaded', () => { showToast(@Html.Raw(Json.Serialize(editProfileError))); openModal('editProfileModal'); });</text>
    }
</script>
