@using System.Security.Claims
@* =====================================================================================
   FILE SUMMARY
   What it does: Bootstrap modal that prompts an authenticated user to create a real
                 password, shown ONLY when the "requires_password_setup" cookie claim is
                 "true" — set by AppClaimsFactory.cs from AuthResponse.RequiresPasswordSetup,
                 which is only true for accounts auto-created via Google/Facebook sign-in
                 (see UserService.ExternalLoginAsync) that haven't set one yet. Included in
                 _Layout.cshtml, so it can appear on top of any authenticated page. Dismissible
                 ("Remind me later") rather than blocking, but re-evaluated fresh from the
                 API's AuthResponse on every sign-in — so if the person closes the modal, or
                 an attempt gets interrupted (e.g. their power goes out mid-submit), it simply
                 shows up again the next time they log in, since nothing about "did they
                 finish" is trusted to the client. Posts to AccountController.SetPassword.
   Entities connected: None — this project has no database entities
   Tables related: None
   ===================================================================================== *@
@if (User.Identity is ClaimsIdentity identity && identity.FindFirst("requires_password_setup")?.Value == "true")
{
    <div class="modal fade" id="setPasswordModal" tabindex="-1" aria-labelledby="setPasswordModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Account" asp-action="SetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="setPasswordModalLabel">Create your password</h5>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">
                            You signed in with Google or Facebook. Create a password so you can also log in with your email directly next time.
                        </p>

                        @if (TempData["SetPasswordError"] is string setPasswordError)
                        {
                            <div class="alert alert-danger">@setPasswordError</div>
                        }

                        <div class="mb-3">
                            <label for="setPasswordNew" class="form-label">New password</label>
                            <input type="password" class="form-control" id="setPasswordNew" name="NewPassword" minlength="8" autocomplete="new-password" required />
                        </div>
                        <div class="mb-3">
                            <label for="setPasswordConfirm" class="form-label">Confirm password</label>
                            <input type="password" class="form-control" id="setPasswordConfirm" name="ConfirmPassword" minlength="8" autocomplete="new-password" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Remind me later</button>
                        <button type="submit" class="btn btn-primary">Create password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('setPasswordModal');
            if (modalEl) {
                new bootstrap.Modal(modalEl).show();
            }
        });
    </script>
}
