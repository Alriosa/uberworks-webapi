@* =====================================================================================
   FILE SUMMARY
   What it does: "Browse everything" page — what the "Y más servicios" card on
                 LandingPage.cshtml links to. Same _LandingLayout.cshtml + _LandingHeader.cshtml
                 as the landing page, but instead of the 6 curated cards with real photos,
                 this is a plain grid of every service category (icon + name only — there's
                 no photo/description per category yet, unlike the curated 6). Clicking a
                 tile calls requestService(name), which just shows a toast — same "decorative
                 for now, no real booking flow yet" situation as LandingPage.cshtml's cards.
                 At the bottom there's a REAL "suggest a service" call-to-action: a button opens
                 a modal (Name, company checkbox + conditional company name, Email, Message,
                 optional file attachment) that posts to HomeController.SuggestService, which
                 relays it to the API's POST /api/contact/suggest-service — an actual email is
                 sent, this is not decorative like the tile clicks above.
   Entities connected: None — this project has no database entities
   Tables related: None
   ===================================================================================== *@
@model uberworks_webapp.Models.ViewModels.SuggestServiceViewModel
@{
    ViewData["Title"] = "Todos los Servicios - ServiGo";
    Layout = "_LandingLayout";
}

