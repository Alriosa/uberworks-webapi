@* =====================================================================================
   FILE SUMMARY
   What it does: "Browse everything" page — what the "Y más servicios" card on
                 LandingPage.cshtml links to. Same _LandingLayout.cshtml + _LandingHeader.cshtml
                 as the landing page. Clicking any of the 24 category tiles calls
                 openServiceModalFromCatalog(key) (wwwroot/js/landing-common.js), which looks the
                 category up in wwwroot/js/service-catalog.js and opens the SAME detail modal
                 used by LandingPage.cshtml's curated cards — photo, description, and a
                 "Pedir servicio" button (still decorative: no real booking flow exists yet in
                 the WebApp). At the bottom there's a REAL "suggest a service" call-to-action: a
                 button opens a modal (Name, company checkbox + conditional company name, Email,
                 Message, optional file attachment) that posts to HomeController.SuggestService,
                 which relays it to the API's POST /api/contact/suggest-service — an actual
                 email is sent, this is not decorative like the tile clicks above. Both modals
                 on this page now share the same open/close animation (opacity + scale on an
                 "#idBox" inner element) provided by landing-common.js, instead of each modal
                 having its own bespoke show/hide logic.
                 "Volver al inicio" at the top routes to Dashboard/LandingPage for a logged-in
                 user and Home/LandingPage for an anonymous visitor — this page is reachable
                 both from the public landing page and from an authenticated Client's dashboard
                 ("Ocupo un trabajo"), and "inicio" means something different for each.
   Entities connected: None — this project has no database entities
   Tables related: None
   ===================================================================================== *@
@model uberworks_webapp.Models.ViewModels.SuggestServiceViewModel
@{
    ViewData["Title"] = "Todos los Servicios - ServiGo";
    Layout = "_LandingLayout";
}

<div class="fixed top-0 left-1/4 w-[600px] h-[600px] bg-glow-1 pointer-events-none rounded-full z-0"></div>
