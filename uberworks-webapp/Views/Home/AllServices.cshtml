@* "Sugerir un servicio" modal — submits a real multipart POST to HomeController.SuggestService,
   which relays it to the API's /api/contact/suggest-service endpoint. Uses the same
   opacity+scale open/close pattern as #serviceModal above (via "#suggestServiceModalBox"), so
   both modals on this page share the exact same openModal()/closeModal() from
   wwwroot/js/landing-common.js instead of each having its own bespoke show/hide logic. *@
<div id="suggestServiceModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="relative glass-card w-full max-w-lg rounded-3xl border border-slate-200 shadow-2xl p-6 sm:p-8 max-h-[90vh] overflow-y-auto transform scale-95 transition-transform duration-300" id="suggestServiceModalBox">
        <button type="button" onclick="closeModal('suggestServiceModal')" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h3 class="text-xl font-black text-slate-900 mb-1">Sugerir un servicio</h3>
        <p class="text-sm text-slate-500 mb-6">Cuéntanos qué servicio te gustaría ver en ServiGo.</p>

        <form asp-controller="Home" asp-action="SuggestService" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label for="suggestName" class="block text-xs font-bold text-slate-700 mb-1">Nombre</label>
                <input type="text" id="suggestName" name="Name" required
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
            </div>

            <div class="flex items-center gap-2">
                <input type="checkbox" id="suggestIsFromCompany" name="IsFromCompany" value="true" onchange="document.getElementById('suggestCompanyNameWrapper').classList.toggle('hidden', !this.checked)"
                       class="w-4 h-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                <label for="suggestIsFromCompany" class="text-sm text-slate-700">¿Vienes de una empresa?</label>
            </div>

            <div id="suggestCompanyNameWrapper" class="hidden">
                <label for="suggestCompanyName" class="block text-xs font-bold text-slate-700 mb-1">Nombre de la empresa</label>
                <input type="text" id="suggestCompanyName" name="CompanyName"
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
            </div>

            <div>
                <label for="suggestEmail" class="block text-xs font-bold text-slate-700 mb-1">Correo electrónico</label>
                <input type="email" id="suggestEmail" name="Email" required
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
            </div>

            <div>
                <label for="suggestMessage" class="block text-xs font-bold text-slate-700 mb-1">Mensaje</label>
                <textarea id="suggestMessage" name="Message" rows="4" required
                          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none"></textarea>
            </div>

            <div>
                <label for="suggestAttachment" class="block text-xs font-bold text-slate-700 mb-1">Adjunto (opcional)</label>
                <input type="file" id="suggestAttachment" name="Attachment"
                       class="w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100" />
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" onclick="closeModal('suggestServiceModal')" class="px-5 py-2.5 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                    Cancelar
                </button>
                <button type="submit" class="btn-alive relative overflow-hidden bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold px-6 py-2.5 rounded-xl transition-colors">
                    Enviar
                </button>
            </div>
        </form>
    </div>
</div>

<script src="~/js/service-catalog.js" asp-append-version="true"></script>
<script src="~/js/landing-common.js" asp-append-version="true"></script>
<script>
    // openModal/closeModal/openServiceModal/openServiceModalFromCatalog/confirmOrder/showToast
    // and the .btn-alive ripple effect all live in wwwroot/js/landing-common.js (shared with
    // LandingPage.cshtml). serviceCatalog lives in wwwroot/js/service-catalog.js (same reason).

    @if (TempData["SuggestServiceSuccess"] is string successMessage)
    {
        <text>document.addEventListener('DOMContentLoaded', () => showToast(@Html.Raw(Json.Serialize(successMessage))));</text>
    }
    @if (TempData["SuggestServiceError"] is string errorMessage)
    {
        <text>document.addEventListener('DOMContentLoaded', () => { showToast(@Html.Raw(Json.Serialize(errorMessage))); openModal('suggestServiceModal'); });</text>
    }
</script>
