@* Service detail modal — identical markup/behavior to LandingPage.cshtml's #serviceModal, so
   clicking any of the 24 tiles above shows the same photo/description/"Pedir servicio"
   experience. Opened via openServiceModalFromCatalog(key) in wwwroot/js/landing-common.js. *@
<div id="serviceModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xl z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card w-full max-w-lg rounded-3xl overflow-hidden border border-slate-200 shadow-2xl relative transform scale-95 transition-transform duration-300" id="serviceModalBox">
        <button onclick="closeModal('serviceModal')" class="absolute top-4 right-4 z-20 text-white w-9 h-9 rounded-full bg-slate-950/70 backdrop-blur-md flex items-center justify-center hover:bg-slate-900 transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="relative h-48">
            <img id="svcImg" src="" alt="Servicio" class="w-full h-full object-cover hidden">
            <div id="svcIconWrap" class="w-full h-full hidden items-center justify-center bg-gradient-to-br from-brand-500 to-emerald-400">
                <i id="svcIcon" class="fa-solid text-white text-5xl"></i>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
        </div>

        <div class="p-6 relative -mt-6">
            <h3 id="svcTitle" class="text-2xl font-black text-slate-900"></h3>
            <p id="svcDesc" class="text-sm text-slate-600 mt-2 leading-relaxed"></p>

            <div class="my-6 p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
                <div class="flex items-center justify-between text-xs text-slate-600">
                    <span><i class="fa-solid fa-shield-check text-brand-500 mr-1.5"></i>Garantía del servicio:</span>
                    <span class="text-slate-900 font-bold">100% Protegido</span>
                </div>
            </div>

            <div class="flex gap-3">
                <button onclick="closeModal('serviceModal')" class="w-1/3 py-3 rounded-xl font-bold text-xs text-slate-600 border border-slate-300 hover:bg-slate-100 transition-colors">
                    Cancelar
                </button>
                <button onclick="confirmOrder()" class="btn-alive w-2/3 py-3 rounded-xl font-bold text-xs text-white bg-brand-500 hover:bg-brand-400 shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>Confirmar y Buscar Técnico</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div id="toast" class="fixed bottom-6 right-6 z-50 glass-card px-5 py-4 rounded-2xl border border-brand-500/50 text-slate-900 shadow-2xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300">
