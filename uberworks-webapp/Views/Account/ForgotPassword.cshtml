@model uberworks_webapp.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1 class="auth-title">Forgot your password?</h1>
    <p class="auth-subtitle">No worries — here's how to get back in:</p>

    <ol class="auth-steps">
        <li>Enter the email address you registered with below.</li>
        <li>Check your inbox for an email from Uberworks with a reset link.</li>
        <li>Click the link and choose a new password — the link is valid for <strong>1 hour</strong> and can only be used once.</li>
        <li>Log in with your new password.</li>
    </ol>
    <p class="auth-footnote" style="margin: 0 0 1.25rem;">
        Didn't get the email? Check your spam folder, or make sure you typed the email you registered with. For security, we never reveal whether an email is registered.
    </p>

    @if (ViewData["SubmittedMessage"] is string submittedMessage)
    {
        <div class="auth-alert">@submittedMessage</div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="auth-alert auth-alert-danger">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div class="auth-input-wrap">
            <label asp-for="Email" class="auth-label">Email address</label>
            <input asp-for="Email" class="auth-input" placeholder="you@company.com" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-auth-primary">Send reset link</button>
    </form>

    <p class="auth-footer-text">
        Remembered your password? <a class="auth-link" asp-controller="Account" asp-action="Login">Log in here</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
