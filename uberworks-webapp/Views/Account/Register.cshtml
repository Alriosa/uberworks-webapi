@model uberworks_webapp.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1 class="auth-title">Create an account</h1>
    <p class="auth-subtitle">Join Uberworks as a client or a professional</p>

    @if (ViewData["GoogleLoginEnabled"] is true)
    {
        <a class="btn-google" asp-controller="Account" asp-action="GoogleLogin">
            <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z" />
                <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.96v2.33A9 9 0 0 0 9 18z" />
                <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.17.28-1.7V4.97H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.03l2.99-2.33z" />
                <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.97l2.99 2.33C4.66 5.17 6.65 3.58 9 3.58z" />
            </svg>
            Continue with Google
        </a>
        <p class="auth-footnote" style="margin-top: 0.5rem;">Signs you up as a Client automatically.</p>

        <div class="auth-divider">OR</div>
    }

    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="auth-input-wrap">
            <label asp-for="Username" class="auth-label"></label>
            <input asp-for="Username" class="auth-input" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="FirstName" class="auth-label"></label>
            <input asp-for="FirstName" class="auth-input" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="LastName" class="auth-label"></label>
            <input asp-for="LastName" class="auth-input" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="Email" class="auth-label">Email address</label>
            <input asp-for="Email" class="auth-input" placeholder="you@company.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="Phone" class="auth-label"></label>
            <input asp-for="Phone" class="auth-input" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="Password" class="auth-label"></label>
            <input asp-for="Password" class="auth-input" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="ConfirmPassword" class="auth-label"></label>
            <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <!-- No Role field here on purpose — this form only ever creates Client accounts.
             Professional/Manager/Company/Admin accounts can only be created by a
             Manager/Admin/MasterAdmin (see AdminController.CreateUser). -->

        <button type="submit" class="btn-auth-primary">Register</button>
    </form>

    <p class="auth-footer-text">
        Already have an account? <a class="auth-link" asp-controller="Account" asp-action="Login">Log in here</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
