@model uberworks_webapp.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1 class="auth-title">Choose a new password</h1>
    <p class="auth-subtitle">This link is single-use and expires 1 hour after it was requested.</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="auth-alert auth-alert-danger">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
            <div>If your link expired, you can <a class="auth-link" asp-controller="Account" asp-action="ForgotPassword">request a new one</a>.</div>
        </div>
    }

    <form asp-controller="Account" asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Token" />

        <div class="auth-input-wrap">
            <label asp-for="NewPassword" class="auth-label">New password</label>
            <input asp-for="NewPassword" class="auth-input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="ConfirmPassword" class="auth-label">Confirm new password</label>
            <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-auth-primary">Reset password</button>
    </form>

    <p class="auth-footer-text">
        <a class="auth-link" asp-controller="Account" asp-action="Login">Back to log in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
