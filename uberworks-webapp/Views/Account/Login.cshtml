@model uberworks_webapp.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<a class="auth-back-btn" asp-controller="Home" asp-action="LandingPage">
    <span aria-hidden="true">&larr;</span>
    <span>Volver al inicio</span>
</a>

<div class="auth-card">
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Sign in to your account to continue</p>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="auth-alert">@successMessage</div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="auth-alert auth-alert-danger">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="None" class="text-danger"></div>

        <div class="auth-input-wrap">
            <label asp-for="Email" class="auth-label">Email address</label>
            <input asp-for="Email" class="auth-input" placeholder="you@company.com" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="auth-input-wrap">
            <label asp-for="Password" class="auth-label">Password</label>
            <div class="auth-input-with-toggle">
                <input asp-for="Password" id="passwordInput" type="password" class="auth-input" autocomplete="current-password" />
                <button type="button" class="auth-toggle-password" onclick="togglePassword()">Show</button>
            </div>
            <div class="auth-forgot-row">
                <a class="auth-link" asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="auth-checkbox-row">
            <input type="checkbox" id="rememberMe" />
            <label for="rememberMe" class="mb-0">Remember me for 30 days</label>
        </div>

        <button type="submit" class="btn-auth-primary">Sign in</button>

        <div class="auth-divider">OR</div>

        @{
            // TODO (pending task): both buttons are shown unconditionally for now, regardless
            // of GoogleLoginOptions/FacebookLoginOptions.IsEnabled — the user asked to see the
            // buttons first and wire up real credentials later. Clicking either one currently
            // 404s via AccountController.GoogleLogin/FacebookLogin until GoogleAuth:ClientId/
            // ClientSecret and FacebookAuth:AppId/AppSecret are set in the WebApp's
            // user-secrets. Revert to checking ViewData["GoogleLoginEnabled"]/
            // ["FacebookLoginEnabled"] (still set by AccountController.Login, unused here for
            // now) once those are configured.
        }
        <div class="auth-oauth-row">
            <a class="btn-google" asp-controller="Account" asp-action="GoogleLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z" />
                    <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.96v2.33A9 9 0 0 0 9 18z" />
                    <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.17.28-1.7V4.97H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.03l2.99-2.33z" />
                    <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.97l2.99 2.33C4.66 5.17 6.65 3.58 9 3.58z" />
                </svg>
                Google
            </a>

            <a class="btn-facebook" asp-controller="Account" asp-action="FacebookLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" fill="#fff">
                    <path d="M18 9a9 9 0 1 0-10.4 8.89v-6.29H5.31V9h2.29V7.02c0-2.26 1.35-3.51 3.41-3.51.99 0 2.02.18 2.02.18v2.22h-1.14c-1.12 0-1.47.7-1.47 1.41V9h2.5l-.4 2.6h-2.1v6.29A9 9 0 0 0 18 9z" />
                </svg>
                Facebook
            </a>
        </div>
    </form>

    <p class="auth-footer-text">
        Don't have an account? <a class="auth-link" asp-controller="Account" asp-action="Register">Request access</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            event.target.textContent = isHidden ? 'Hide' : 'Show';
        }
    </script>
}
